# ============================================================
# BarberWeb v1.0 — Variables de entorno
# Copia este archivo como ".env" y sustituye los valores de ejemplo.
#
#   cp .env.example .env
#
# NUNCA subas el archivo ".env" al repositorio: contiene secretos.
# Este archivo es el único que se versiona, y todos sus valores son de ejemplo.
# ============================================================

# Supabase: conexión y autenticación 
# El proyecto de Supabase.
# La clave "publishable" es pública por diseño: es la que usa el navegador.
# La clave secreta "service_role" NO va aquí: solo se usa dentro de las
# funciones de servidor y vive en Supabase Vault.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=ejemplo_clave_publicable_de_supabase

# Barbería por defecto
# Barbería que se muestra cuando el visitante entra por el dominio base
# (sin subdominio de barbería). Debe existir en la tabla `barberias`.
# Formato: 3 a 40 caracteres, minúsculas y guiones.
VITE_BARBERIA_SLUG=kromatik

# Dominio base 
# Base contra la que se resuelve el subdominio de cada barbería.
# El sitio de la barbería `kromatik` quedaría en
# https://kromatik.<VITE_DOMINIO_BASE>
VITE_DOMINIO_BASE=<ejemplo de dominio>

# Resend: envío de correos 
# SOLO para las funciones de servidor. Es un secreto:
# nunca se usa en el navegador y nunca se sube al repositorio.
# Se rota en https://resend.com/api-keys
RESEND_API_KEY=re_CLAVE_DE_EJEMPLO_NO_FUNCIONA
